{
  "name": "caderno-de-receitas",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["backend", "frontend"],
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w backend && npm run build -w frontend",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w backend",
    "test:integration": "npm run test:integration -w backend",
    "test:e2e": "playwright test",
    "db:migrate": "npm run db:migrate -w backend",
    "db:seed": "npm run db:seed -w backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.1"
  }
}
